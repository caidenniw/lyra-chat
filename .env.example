# Lyra Chat — Environment Variables
# Copy this file to .env and fill in the values

# Supabase (Auth & Database)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Provider (OpenCode Zen or compatible OpenAI endpoint)
# Free tier: leave AI_API_KEY empty
# Paid tier: set your API key here
AI_BASE_URL=https://opencode.ai/zen/v1/chat/completions
AI_API_KEY=

# Comma-separated list of allowed model IDs
AI_ALLOWED_MODELS=hy3-free,deepseek-v4-flash-free,mimo-v2.5-free,nemotron-3-ultra-free

# Max tokens per response
AI_MAX_TOKENS=32768
